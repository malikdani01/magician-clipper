# Magician Clipper — web app environment (Phase 2).
# Copy to .env for local development.
#
# Local defaults: Laravel runs on :8000, the video engine on :8001.

# Laravel API base (no trailing slash issues — the client appends paths).
VITE_API_URL=http://127.0.0.1:8000/api/v1

# FastAPI video engine base (probe, extract-audio, jobs, health).
VITE_ENGINE_URL=http://127.0.0.1:8001

# Laravel app base, used for the /up health check.
VITE_APP_URL=http://127.0.0.1:8000
