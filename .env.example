# Magician Clipper — root environment template
# Copy to .env and fill in. NEVER commit a real .env or real secrets.
# See docs/environment.md for every variable, its default and whether required.

# --- App ---------------------------------------------------------------------
APP_NAME="Magician Clipper"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:5173
APP_KEY=

# --- URLs (service discovery) ------------------------------------------------
FRONTEND_URL=http://localhost:5173
LARAVEL_URL=http://127.0.0.1:8000
VIDEO_ENGINE_URL=http://127.0.0.1:8001

# --- Database ----------------------------------------------------------------
# SQLite is the local/desktop default. MySQL/PostgreSQL are supported for
# multi-user server deployment (see docs/environment.md).
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=
# DB_PASSWORD=

# --- Queue -------------------------------------------------------------------
# database = lightweight local queue (default, no Redis required).
# sync = run jobs inline (dev only). redis = optional backend.
QUEUE_CONNECTION=database
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# --- Storage paths (relative to repo root unless absolute) --------------------
STORAGE_UPLOADS_PATH=storage/uploads
STORAGE_PROJECTS_PATH=storage/projects
STORAGE_CLIPS_PATH=storage/clips
STORAGE_EXPORTS_PATH=storage/exports
STORAGE_THUMBNAILS_PATH=storage/thumbnails
STORAGE_TEMP_PATH=storage/temp
STORAGE_LOGS_PATH=storage/logs

# --- Uploads / processing limits ---------------------------------------------
MAX_UPLOAD_MB=2048
MAX_VIDEO_DURATION_SECONDS=7200
ALLOWED_VIDEO_EXTENSIONS=mp4,mov,mkv,webm
PROCESSING_CONCURRENCY=1
TEMP_RETENTION_HOURS=24

# --- Video engine ------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WHISPER_MODEL=tiny
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4

# --- Optional AI adapters (disabled by default; core works without them) -----
OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=
GEMINI_ENABLED=false
# GEMINI_API_KEY=

# --- Auth / sessions ---------------------------------------------------------
SESSION_DRIVER=file
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Muse-connected Job System (Phase 3) — see backend/laravel/.env.example.
# The real key lives ONLY in backend/laravel/.env (MUSE_JOB_API_KEY).
MUSE_JOB_API_KEY=
